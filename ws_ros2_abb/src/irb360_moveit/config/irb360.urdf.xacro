<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="irb360">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import irb360 urdf file -->
    <xacro:include filename="$(find irb360)/urdf/irb360.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="irb360.ros2_control.xacro" />


    <xacro:irb360_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
