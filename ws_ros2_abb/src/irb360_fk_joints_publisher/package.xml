<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>irb360_fk_joints_publisher</name>
  <version>0.0.1</version>
  <description>
    This package take the four joint angles of a delta IRB360 robot as input, and publishes the complete joints set.
  </description>
  <maintainer email="micmazur@pg.edu.pl">Michał Mazur</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
