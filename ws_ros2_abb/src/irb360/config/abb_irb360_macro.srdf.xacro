    <disable_collisions link1="Link_Axis1" link2="Link_Axis4_4" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis4_5" reason="Never"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis4_6" reason="Never"/>
