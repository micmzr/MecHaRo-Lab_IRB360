    <disable_collisions link1="Link_Axis2_1_3" link2="Link_Axis4_3" reason="Never"/>
    <disable_collisions link1="Link_Axis2_1_3" link2="Link_Axis4_4" reason="Never"/>
    <disable_collisions link1="Link_Axis2_1_3" link2="Link_Axis4_5" reason="Never"/>
