<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="irb360_srdf">

    <group name="irb360">
        <chain base_link="base_link" tip_link="tool0" />
        <joint name="joint_1"/>
        <joint name="joint_1_1_1"/>
        <joint name="joint_1_1_2"/>
        <joint name="joint_1_1_3"/>
        <joint name="joint_1_2_1"/>
        <joint name="joint_1_2_2"/>
        <joint name="joint_1_2_3"/>
        <joint name="joint_2"/>
        <joint name="joint_2_1_1"/>
        <joint name="joint_2_1_2"/>
        <joint name="joint_2_1_3"/>
        <joint name="joint_2_2_1"/>
        <joint name="joint_2_2_2"/>
        <joint name="joint_2_2_3"/>
        <joint name="joint_3"/>
        <joint name="joint_3_1_1"/>
        <joint name="joint_3_1_2"/>
        <joint name="joint_3_1_3"/>
        <joint name="joint_3_2_1"/>
        <joint name="joint_3_2_2"/>
        <joint name="joint_3_2_3"/>
        <joint name="joint_4"/>
        <joint name="joint_4_2"/>
        <joint name="joint_4_3"/>
        <joint name="joint_4_4"/>
        <joint name="joint_4_5"/>
        <joint name="joint_4_6"/>
        <joint name="joint_4_7"/>
    </group>
    <!--PASSIVE JOINT: Purpose: this element is used to mark joints that are not actuated-->
    <passive_joint name="joint_1_1_1"/>
    <passive_joint name="joint_1_1_2"/>
    <passive_joint name="joint_1_1_3"/>
    <passive_joint name="joint_1_2_1"/>
    <passive_joint name="joint_1_2_2"/>
    <passive_joint name="joint_1_2_3"/>
    <passive_joint name="joint_2_1_1"/>
    <passive_joint name="joint_2_1_2"/>
    <passive_joint name="joint_2_1_3"/>
    <passive_joint name="joint_2_2_1"/>
    <passive_joint name="joint_2_2_2"/>
    <passive_joint name="joint_2_2_3"/>
    <passive_joint name="joint_3_1_1"/>
    <passive_joint name="joint_3_1_2"/>
    <passive_joint name="joint_3_1_3"/>
    <passive_joint name="joint_3_2_2"/>
    <passive_joint name="joint_3_2_1"/>
    <passive_joint name="joint_3_2_3"/>
    <passive_joint name="joint_4_2"/>
    <passive_joint name="joint_4_3"/>
    <passive_joint name="joint_4_4"/>
    <passive_joint name="joint_4_5"/>
    <passive_joint name="joint_4_6"/>
    <passive_joint name="joint_4_7"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="joint_0" type="floating" parent_frame="world" child_link="base_link" />
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="Link_Axis4" reason="Adjacent" />
    <disable_collisions link1="Link_Axis1" link2="Link_Axis1_1_3" reason="Adjacent"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis1_2_3" reason="Adjacent"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis2" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis2_1_3" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis2_2_3" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis3" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis3_1_3" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis3_2_3" reason="User"/>
    <disable_collisions link1="Link_Axis1" link2="Link_Axis4" reason="User"/>
